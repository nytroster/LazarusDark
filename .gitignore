# ==========================================
# Lazarus & Free Pascal .gitignore Template
# ==========================================

# --- Compiler-generated binaries & objects (Safe to delete) ---
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.or
*.ppu
*.compiled
*.dbg
*.lrs
*.res

# --- Autogenerated translation & info artifacts ---
*.rst
*.rsj
*.lrt

# --- Local & User-specific IDE configurations ---
# (Excluding this prevents layout conflicts across different developer setups)
*.lps
*.lfm.bak
*.lpi.bak
lazarus.cfg

# --- Project Backups & Output Folders ---
backup/
lib/
units/
*.bak
*.~*
.*~
.$*

# --- macOS Application Bundles ---
*.app/
